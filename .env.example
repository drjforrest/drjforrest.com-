# AI Configuration (Development Only)
# Choose either 'mistral' or 'deepseek'
AI_PROVIDER=deepseek

# API Key for your chosen provider (Development Only)
# For production, this is configured in Vercel environment variables
# For local development: Get API key from your provider
# For DeepSeek: https://platform.deepseek.com/api_keys
# For Mistral: https://console.mistral.ai/api-keys

# Provider-specific API keys (recommended)
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=your_mistral_api_key_here

# Generic fallback (deprecated, use provider-specific keys above)
AI_API_KEY=your_api_key_here

# Optional: Override default model
# DeepSeek: deepseek-chat, deepseek-coder
# Mistral: mistral-small-latest, mistral-medium-latest, mistral-large-latest
# AI_MODEL=deepseek-chat

# Research Network API
# The citation network now runs as Next.js routes at /api/citation
# (OpenAlex public API). The old FastAPI proxy is no longer required.
# RESEARCH_NETWORK_INTERNAL_URL=http://127.0.0.1:8001

# Radar internal download portal (/apps/radar)
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(18))"
RADAR_PORTAL_PASSWORD=
RADAR_PORTAL_SECRET=
# Set to 1 in production behind HTTPS
RADAR_PORTAL_SECURE=0

# Bibliography invite portal (/apps/bibliography) → library.drjforrest.com
BIBLIOGRAPHY_URL=https://library.drjforrest.com
BIBLIOGRAPHY_ACCESS_CODE=
# Optional; falls back to RADAR_PORTAL_SECRET
BIBLIOGRAPHY_PORTAL_SECRET=
