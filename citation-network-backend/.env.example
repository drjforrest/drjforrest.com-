# Environment
ENV=development
DEBUG=True

# API Keys
SERPAPI_KEY=your_serpapi_key_here

# Optional - Semantic Scholar API key (free tier works fine without this)
SEMANTIC_SCHOLAR_API_KEY=

# Optional - LLM API keys for semantic cluster labeling
# DeepSeek is recommended (cheaper): https://platform.deepseek.com/
# OpenAI as fallback: https://platform.openai.com/
# If neither is set, will use simple word-frequency labeling
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# Demo/Default Google Scholar ID - used for initial data load and demos
# Find yours at: https://scholar.google.com/citations?user=YOUR_ID
# Users can fetch ANY author's data via the API dynamically
DEFAULT_GOOGLE_SCHOLAR_AUTHOR_ID=your_google_scholar_author_id

# CORS - Add your frontend URLs
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001","https://drjforrest.com","https://www.drjforrest.com"]

# Database (optional)
DATABASE_URL=sqlite:///./research_network.db
