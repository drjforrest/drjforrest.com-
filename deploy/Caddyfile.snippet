# Forrest Insights — drjforrest.com apex + www
# Append this block to /etc/caddy/Caddyfile, then `sudo systemctl reload caddy`

drjforrest.com, www.drjforrest.com {
	# www → apex
	@www host www.drjforrest.com
	redir @www https://drjforrest.com{uri} 301

	reverse_proxy localhost:3005 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}

	encode gzip zstd

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		# HSTS — only enable after confirming TLS works end-to-end
		# Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	log {
		output file /var/log/caddy/forrest-insights.log {
			roll_size 50MiB
			roll_keep 7
			roll_keep_for 720h
		}
		format json
	}
}
