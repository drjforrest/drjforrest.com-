[Unit]
Description=Forrest Insights Next.js Frontend
After=network.target

[Service]
Type=simple
User=admin
Group=admin
WorkingDirectory=/var/www/forrest-insights
EnvironmentFile=/var/www/forrest-insights/.env
Environment=NODE_ENV=production
Environment=PORT=3005
Environment=HOSTNAME=127.0.0.1
ExecStart=/var/www/forrest-insights/node_modules/.bin/next start --port 3005 --hostname 127.0.0.1
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=20
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=forrest-frontend

NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/var/www/forrest-insights

[Install]
WantedBy=multi-user.target
