# Forrest Insights — VPS production env
# Copy to deploy/.env.production (gitignored) and fill in real values.
# The deploy script will scp this to /var/www/forrest-insights/.env on the server.

NODE_ENV=production
# Port note (2026-05-19): forrest-frontend runs on :3005, NOT :3003.
# The same VPS hosts manuscripts-app on :3003 (separate systemd unit,
# separate Caddy vhost — managed independently, has its own automation
# pipelines feeding it). Do not change manuscripts-app's port. If you
# need to move forrest-frontend again, also update:
#   - deploy/forrest-frontend.service (Environment=PORT + ExecStart --port)
#   - deploy/Caddyfile.snippet (reverse_proxy localhost:PORT)
#   - deploy/deploy-frontend.sh (SERVICE_PORT)
#   - /etc/caddy/Caddyfile on the VPS (drjforrest.com block) + reload caddy
PORT=3005
HOSTNAME=127.0.0.1

# AI provider (Genkit / lib/ai-client.ts)
AI_PROVIDER=deepseek
AI_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=

# Research network API — same VPS, internal hop
NEXT_PUBLIC_API_URL=https://citation-network.drjforrest.com
