# Forrest Insights — VPS production env
# Copy to deploy/.env.production (gitignored) and fill in real values.
# The deploy script merges this with non-empty keys from .env.local, then
# copies the result to /var/www/forrest-insights/.env on the server.

NODE_ENV=production
# Port note (2026-05-19): forrest-frontend runs on :3005, NOT :3003.
# The same VPS hosts manuscripts-app on :3003 (separate systemd unit,
# separate Caddy vhost — managed independently, has its own automation
# pipelines feeding it). Do not change manuscripts-app's port. If you
# need to move forrest-frontend again, also update:
#   - deploy/forrest-frontend.service (Environment=PORT + ExecStart --port)
#   - deploy/Caddyfile.snippet (reverse_proxy localhost:PORT)
#   - deploy/deploy-frontend.sh (SERVICE_PORT)
#   - /etc/caddy/Caddyfile on the VPS (drjforrest.com block) + reload caddy
PORT=3005
HOSTNAME=127.0.0.1

# AI provider (Genkit / lib/ai-client.ts)
AI_PROVIDER=deepseek
AI_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=

# Research network API — browser calls same-origin `/citation-api/*`,
# which Next.js rewrites to the FastAPI service on this VPS.
RESEARCH_NETWORK_INTERNAL_URL=http://127.0.0.1:8001

# Radar internal download portal (/apps/radar)
RADAR_PORTAL_PASSWORD=
RADAR_PORTAL_SECRET=
RADAR_PORTAL_SECURE=1

# Bibliography invite portal (/apps/bibliography) → library.drjforrest.com
BIBLIOGRAPHY_URL=https://library.drjforrest.com
BIBLIOGRAPHY_ACCESS_CODE=
BIBLIOGRAPHY_PORTAL_SECRET=

# Writing hub destinations (optional; defaults are in src/lib/writing-sites.ts)
# NEXT_PUBLIC_MIND_THE_GAP_URL=https://mind-the-gap.drjforrest.com
# NEXT_PUBLIC_ROUNDS_URL=https://rounds-and-square-pegs.drjforrest.com
