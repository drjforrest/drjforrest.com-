[Unit]
Description=Mind the Gap Next.js Blog
After=network.target

[Service]
Type=simple
User=admin
Group=admin
WorkingDirectory=/var/www/mind-the-gap
EnvironmentFile=-/var/www/mind-the-gap/.env
Environment=NODE_ENV=production
Environment=PORT=3007
Environment=HOSTNAME=127.0.0.1
ExecStart=/var/www/mind-the-gap/node_modules/.bin/next start --port 3007 --hostname 127.0.0.1
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=20
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mind-the-gap

NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/var/www/mind-the-gap

[Install]
WantedBy=multi-user.target
